# PostgreSQL database connection string (Supabase, Neon, Railway, or AWS RDS)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# JWT configuration
JWT_SECRET="your_secure_jwt_secret_here"
JWT_EXPIRES_IN="30d"

# Server Port (optional, provided automatically by platforms like Render/Railway/Heroku)
PORT=5000

# Client origin for CORS (e.g., https://your-staynest-client.vercel.app or http://localhost:5173)
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"
